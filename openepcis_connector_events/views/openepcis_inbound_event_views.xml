<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_openepcis_inbound_event_list" model="ir.ui.view">
    <field name="name">openepcis.inbound.event.list</field>
    <field name="model">openepcis.inbound.event</field>
    <field name="arch" type="xml">
      <list string="Events received" create="false" edit="false"
            decoration-muted="state == 'ignored'"
            decoration-info="state == 'unmatched'"
            decoration-danger="state == 'failed'"
            decoration-warning="state == 'proposed'"
            decoration-success="state == 'booked'">
        <field name="event_time"/>
        <field name="party_gln" string="Reported by"/>
        <field name="biz_step"/>
        <field name="disposition" optional="show"/>
        <field name="epc_ref" string="Identifier"/>
        <field name="state"/>
        <field name="posting_note" optional="show"/>
        <field name="observed_only" optional="hide"/>
        <field name="record_time" optional="hide"/>
        <field name="event_uuid" optional="hide"/>
        <field name="company_id" groups="base.group_multi_company" optional="hide"/>
      </list>
    </field>
  </record>

  <record id="view_openepcis_inbound_event_form" model="ir.ui.view">
    <field name="name">openepcis.inbound.event.form</field>
    <field name="model">openepcis.inbound.event</field>
    <field name="arch" type="xml">
      <form string="Event received" create="false" edit="false">
        <header>
          <field name="state" widget="statusbar" statusbar_visible="received,matched,posted,proposed,booked"/>
        </header>
        <sheet>
          <group>
            <group string="What happened">
              <field name="biz_step"/>
              <field name="disposition"/>
              <field name="event_time"/>
              <field name="epc_ref"/>
            </group>
            <group string="Where it came from">
              <field name="party_gln"/>
              <field name="record_time"/>
              <field name="event_uuid"/>
              <field name="company_id" groups="base.group_multi_company"/>
              <field name="error" invisible="not error"/>
            </group>
          </group>
          <notebook>
            <page string="Event">
              <field name="payload" widget="ace" options="{'mode': 'json'}" readonly="1"/>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_openepcis_inbound_events" model="ir.actions.act_window">
    <field name="name">Events received</field>
    <field name="res_model">openepcis.inbound.event</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Nothing has come in yet.</p>
      <p>
        What partners report about identifiers of ours appears here. It is shown,
        never posted: an event from somebody else is an observation, and stock is
        a figure that belongs to the books.
      </p>
    </field>
  </record>

  <menuitem id="menu_openepcis_inbound_events"
            name="EPCIS events received"
            parent="stock.menu_warehouse_report"
            action="action_openepcis_inbound_events"
            sequence="96"/>

</odoo>

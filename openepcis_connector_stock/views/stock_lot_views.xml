<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!--
    The lot form gains the same publication block the product variant has,
    plus two things of its own: the waiting notice (a lot is gated on its
    product, and the form should say so rather than leave a silent
    "Not published"), and the QR code inline — a lot label is the thing a
    warehouse actually prints and sticks on a box, so the code belongs where
    the person is.
  -->
  <record id="view_production_lot_form_openepcis" model="ir.ui.view">
    <field name="name">stock.lot.form.openepcis</field>
    <field name="model">stock.lot</field>
    <field name="inherit_id" ref="stock.view_production_lot_form"/>
    <field name="arch" type="xml">
      <xpath expr="//group[@name='main_group']" position="after">
        <group string="GS1 / OpenEPCIS" name="openepcis">
          <group>
            <field name="openepcis_publish"/>
            <field name="openepcis_state" widget="badge"
                   decoration-success="openepcis_state == 'synced'"
                   decoration-warning="openepcis_state == 'queued'"
                   decoration-danger="openepcis_state == 'error'"
                   invisible="not openepcis_publish"/>
            <field name="openepcis_error"
                   invisible="openepcis_state != 'error'"
                   class="text-danger"/>
            <field name="openepcis_product_notice" readonly="1" class="text-warning"
                   invisible="not openepcis_product_notice"/>
            <field name="openepcis_digital_link" widget="url" readonly="1"
                   invisible="not openepcis_digital_link"/>
            <div colspan="2">
              <button name="action_openepcis_publish"
                      type="object"
                      string="Publish now"
                      icon="fa-cloud-upload"
                      class="btn-primary"/>
              <button name="action_openepcis_open_digital_link"
                      type="object"
                      string="Open Digital Link"
                      icon="fa-external-link"
                      class="btn-secondary"
                      invisible="not openepcis_digital_link"/>
            </div>
          </group>
          <group>
            <field name="openepcis_qr_src" widget="image_url" nolabel="1"
                   invisible="not openepcis_qr_src"
                   options="{'size': [180, 180]}"/>
          </group>
        </group>
      </xpath>
    </field>
  </record>

  <record id="view_production_lot_tree_openepcis" model="ir.ui.view">
    <field name="name">stock.lot.list.openepcis</field>
    <field name="model">stock.lot</field>
    <field name="inherit_id" ref="stock.view_production_lot_tree"/>
    <field name="arch" type="xml">
      <field name="name" position="after">
        <field name="openepcis_state" optional="hide" widget="badge"
               decoration-success="openepcis_state == 'synced'"
               decoration-warning="openepcis_state == 'queued'"
               decoration-danger="openepcis_state == 'error'"/>
      </field>
    </field>
  </record>

  <!-- Mass action: opting a selection in is the normal way to start. -->
  <record id="action_lot_openepcis_publish" model="ir.actions.server">
    <field name="name">Publish to OpenEPCIS</field>
    <field name="model_id" ref="stock.model_stock_lot"/>
    <field name="binding_model_id" ref="stock.model_stock_lot"/>
    <field name="binding_view_types">list</field>
    <field name="state">code</field>
    <field name="code">action = records.action_openepcis_publish()</field>
  </record>

</odoo>

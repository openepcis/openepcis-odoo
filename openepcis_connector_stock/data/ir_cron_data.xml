<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">

    <!--
      Same five-minute rhythm as products, and deliberately a separate job:
      lots wait for their product, so a lot queued alongside its product is
      published one cron beat after it — the product run releases the waiting
      lots, this run picks them up.
    -->
    <record id="cron_publish_lots" model="ir.cron">
      <field name="name">OpenEPCIS: publish lots and serial numbers</field>
      <field name="model_id" ref="stock.model_stock_lot"/>
      <field name="state">code</field>
      <field name="code">model._openepcis_cron_sync()</field>
      <field name="interval_number">5</field>
      <field name="interval_type">minutes</field>
      <field name="nextcall" eval="(DateTime.now() + timedelta(minutes=5)).strftime('%Y-%m-%d %H:%M:%S')"/>
      <field name="active" eval="True"/>
    </record>

  </data>
</odoo>

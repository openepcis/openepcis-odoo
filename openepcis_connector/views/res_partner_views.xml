<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="res_partner_form_view_openepcis" model="ir.ui.view">
    <field name="name">res.partner.form.openepcis</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form"/>
    <field name="arch" type="xml">

      <!-- The GLN belongs next to the other identifiers, not on a page of its own. -->
      <xpath expr="//field[@name='vat']" position="after">
        <field name="openepcis_gln"
               string="GLN"
               placeholder="13 digits"
               invisible="not is_company"/>
      </xpath>

      <xpath expr="//notebook" position="inside">
        <page string="GS1 / OpenEPCIS" name="openepcis" invisible="not is_company">
          <group>
            <group string="Publication">
              <field name="openepcis_publish"/>
              <field name="openepcis_state" widget="badge"
                     decoration-success="openepcis_state == 'synced'"
                     decoration-warning="openepcis_state == 'queued'"
                     decoration-danger="openepcis_state == 'error'"
                     invisible="not openepcis_publish"/>
              <field name="openepcis_error"
                     invisible="openepcis_state != 'error'"
                     class="text-danger"/>
              <field name="openepcis_digital_link" widget="url" readonly="1"
                     invisible="not openepcis_digital_link"/>
            </group>
          </group>
          <group>
            <field name="openepcis_key_state" invisible="openepcis_key_state == 'own'"/>
            <field name="openepcis_missing_terms" readonly="1" class="text-warning"
                   invisible="not openepcis_missing_terms"/>
          </group>
          <div class="mt16">
            <button name="action_openepcis_draw_key"
                    type="object"
                    string="Draw GLN"
                    icon="fa-magic"
                    class="btn-secondary"
                    invisible="openepcis_gln"
                    confirm="Take the next free GLN from your company prefix? It is held for this contact and registered with GS1 only when the contact is published."/>
            <button name="action_openepcis_release_key"
                    type="object"
                    string="Hand the GLN back"
                    icon="fa-undo"
                    class="btn-link"
                    invisible="openepcis_key_state != 'candidate'"/>
            <button name="action_openepcis_publish"
                    type="object"
                    string="Publish now"
                    icon="fa-cloud-upload"
                    class="btn-primary"
                    invisible="not openepcis_gln"/>
          </div>
          <p class="text-muted mt16">
            Published as a GS1 organization, anchored on application identifier
            417 — the party, as distinct from a physical location. Individuals
            are never published.
          </p>
        </page>
      </xpath>

    </field>
  </record>

  <record id="action_partner_openepcis_publish" model="ir.actions.server">
    <field name="name">Publish to OpenEPCIS</field>
    <field name="model_id" ref="base.model_res_partner"/>
    <field name="binding_model_id" ref="base.model_res_partner"/>
    <field name="binding_view_types">list</field>
    <field name="state">code</field>
    <field name="code">action = records.filtered('is_company').action_openepcis_publish()</field>
  </record>

</odoo>

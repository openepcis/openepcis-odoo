<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="res_config_settings_view_form" model="ir.ui.view">
    <field name="name">res.config.settings.form.inherit.openepcis</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="base.res_config_settings_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//form" position="inside">
        <app string="OpenEPCIS"
             name="openepcis_connector"
             logo="/openepcis_connector/static/description/icon.png">

          <block title="Connection" name="openepcis_connection">
            <setting string="Publish to OpenEPCIS"
                     help="Queue products and partners for publication to the GS1 Digital Link resolver. Turning this off stops the queue from being drained; nothing already published is withdrawn.">
              <field name="openepcis_enabled"/>
              <div class="content-group mt16" invisible="not openepcis_enabled">
                <div class="row">
                  <label for="openepcis_base_url" class="col-lg-3 o_light_label"/>
                  <field name="openepcis_base_url"
                         placeholder="https://id.epcis.cloud"
                         required="openepcis_enabled"/>
                </div>
                <div class="row">
                  <label for="openepcis_api_key" class="col-lg-3 o_light_label"/>
                  <field name="openepcis_api_key"
                         password="True"
                         required="openepcis_enabled"/>
                </div>
                <div class="row">
                  <label for="openepcis_api_secret" class="col-lg-3 o_light_label"/>
                  <field name="openepcis_api_secret"
                         password="True"
                         required="openepcis_enabled"/>
                </div>
                <div class="mt8">
                  <button name="action_openepcis_test_connection"
                          type="object"
                          string="Test connection"
                          icon="fa-plug"
                          class="btn-link"/>
                  <button name="action_openepcis_refresh_channels"
                          type="object"
                          string="Refresh destinations"
                          icon="fa-refresh"
                          class="btn-link"/>
                </div>
                <div class="text-muted mt8">
                  The API key stands for a Keycloak identity. Publishing needs a
                  tenant role and a <code>defaultGroup</code> claim; drawing
                  identifiers additionally needs <code>gs1CompanyPrefix</code>.
                  Test connection reports which of these are present.
                </div>
              </div>
            </setting>
          </block>

        </app>
      </xpath>
    </field>
  </record>

</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="openepcis_gpc_search_view_form" model="ir.ui.view">
    <field name="name">openepcis.gpc.search.form</field>
    <field name="model">openepcis.gpc.search</field>
    <field name="arch" type="xml">
      <form string="Find a GPC brick">
        <group>
          <field name="category_id" readonly="1"/>
          <field name="searched" invisible="1"/>
          <label for="query"/>
          <div class="o_row">
            <field name="query" placeholder="e.g. bicycle bell, or 10000045"/>
            <button name="action_search" type="object" string="Search"
                    class="btn-primary" icon="fa-search"/>
          </div>
        </group>

        <field name="result_ids" nolabel="1" invisible="not searched">
          <list create="false" delete="false">
            <field name="code"/>
            <field name="title"/>
            <field name="lineage" optional="show"/>
            <field name="definition" optional="hide"/>
            <button name="action_choose" type="object" string="Use this one"
                    class="btn-link" icon="fa-check"/>
          </list>
        </field>

        <p class="text-muted" invisible="not searched or result_ids">
          Nothing matched. Try a broader word — the classification names things
          the way a retailer would, not the way your catalogue does.
        </p>

        <footer>
          <button string="Close" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="action_openepcis_gpc_search" model="ir.actions.act_window">
    <field name="name">Find a GPC brick</field>
    <field name="res_model">openepcis.gpc.search</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
    <field name="binding_model_id" ref="product.model_product_category"/>
    <field name="binding_view_types">form</field>
  </record>

</odoo>

# Part of the OpenEPCIS connector for Odoo. See LICENSE (LGPL-3).
#
# Demo image for the demo-odoo Terraform module (openepcis-platform):
# stock Odoo 18 with the connector addons preinstalled.
#
# They ship together because they are one story: the connector publishes the
# product, the stock bridge the lots and serials underneath it, the expiry
# bridge the dates GS1 asks about on those lots, and the events addon what
# became of them. Three carry auto_install, so Odoo decides for itself whether
# they apply — an image without stock installed never activates the stock
# bridge, and one without a till never reads a sale as a sale.
#
# The base image is fully qualified: podman on a host without
# unqualified-search registries refuses a short name outright.
#
# Build from the repo root (the context must be the root so the addon
# directories are inside it):
#
#   podman build --platform linux/amd64 -f docker/demo/Containerfile \
#     -t registry.company-group.com/openepcis/openepcis-connectors/odoo-demo:18 .
#
# See docker/demo/README.md for the registry path, multi-arch and pushing.

FROM docker.io/library/odoo:18

# /mnt/extra-addons is already on the addons_path of the official image.
COPY --chown=odoo:odoo openepcis_connector /mnt/extra-addons/openepcis_connector
COPY --chown=odoo:odoo openepcis_connector_stock /mnt/extra-addons/openepcis_connector_stock
COPY --chown=odoo:odoo openepcis_connector_product_expiry /mnt/extra-addons/openepcis_connector_product_expiry
COPY --chown=odoo:odoo openepcis_connector_events /mnt/extra-addons/openepcis_connector_events
COPY --chown=odoo:odoo openepcis_connector_events_pos /mnt/extra-addons/openepcis_connector_events_pos

# The canonical CBV event hash. The events addon declares it as an
# external_dependency, so without it Odoo lists the addon as uninstallable —
# which is the honest failure, but not a useful image.
#
# --break-system-packages because the official image is Debian and Odoo's own
# Python packages live in the system interpreter; a venv here would be a second
# interpreter that Odoo does not use. The package brings PyLD, frozendict,
# cachetools and Flask, the last without a single import in its own code. That
# was weighed: one implementation of the canonicalisation rules beats a second,
# leaner one that disagrees with the first.
USER root
RUN pip3 install --no-cache-dir --break-system-packages \
        "epcis-event-hash-generator==1.9.3"
USER odoo
